const express = require("express");

const app = express();

const PORT = 3000;


// ==========================================
// MIDDLEWARE
// ==========================================

app.use((req, res, next) => {

    console.log("Middleware executed");

    next();

});


// ==========================================
// HOME ROUTE
// ==========================================

app.get("/", (req, res) => {

    res.send("Home Page");

});


// ==========================================
// PROPERTY ROUTE
// ==========================================

app.get("/api/properties", (req, res) => {

    res.json({
        success: true,
        message: "Properties returned"
    });

});


// ==========================================
// START SERVER
// ==========================================

app.listen(PORT, () => {

    console.log(`Server running on http://localhost:${PORT}`);

});
