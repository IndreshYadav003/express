// ======================================================
// EXPRESS LESSON 4
// Topic: Request Body + express.json()
// ======================================================


// Import the Express framework
const express = require("express");


// Create an Express application
const app = express();


// Port number on which our server will run
const PORT = 3000;


// ======================================================
// MIDDLEWARE
// ======================================================

// express.json() allows Express to read JSON data
// sent by the client inside req.body.
//
// Example JSON sent by client:
//
// {
//     "name": "Green Valley Residency",
//     "location": "Bangalore",
//     "type": "2BHK",
//     "price": 5000000
// }

app.use(express.json());


// ======================================================
// HOME ROUTE
// ======================================================

// GET request
// URL: http://localhost:3000/

app.get("/", (req, res) => {

    // Send JSON response to the client
    res.json({
        success: true,
        message: "Real Estate API is running"
    });

});


// ======================================================
// CREATE PROPERTY
// ======================================================

// POST request
// URL:
// http://localhost:3000/api/properties

app.post("/api/properties", (req, res) => {


    // --------------------------------------------------
    // GET DATA FROM REQUEST BODY
    // --------------------------------------------------

    // req.body contains JSON data sent by the client.

    const {
        name,
        location,
        type,
        price
    } = req.body;


    // --------------------------------------------------
    // DISPLAY DATA IN TERMINAL
    // --------------------------------------------------

    console.log("Property Name:", name);
    console.log("Location:", location);
    console.log("Type:", type);
    console.log("Price:", price);


    // --------------------------------------------------
    // VALIDATION
    // --------------------------------------------------

    // Check whether all required fields are present.

    if (!name || !location || !type || !price) {

        // return stops the function here.
        // The route will not continue.

        return res.status(400).json({

            success: false,

            message: "All fields are required"

        });

    }


    // --------------------------------------------------
    // CREATE PROPERTY OBJECT
    // --------------------------------------------------

    const property = {

        name: name,

        location: location,

        type: type,

        price: price

    };


    // --------------------------------------------------
    // SEND RESPONSE
    // --------------------------------------------------

    res.status(201).json({

        success: true,

        message: "Property created successfully",

        data: property

    });

});


// ======================================================
// UPDATE PROPERTY EXAMPLE
// ======================================================

// PUT request
// This example shows that PUT can also receive
// data through req.body.
//
// URL:
// http://localhost:3000/api/properties/101

app.put("/api/properties/:id", (req, res) => {


    // Get property ID from URL
    const propertyId = req.params.id;


    // Get updated data from request body
    const {
        name,
        location,
        type,
        price
    } = req.body;


    // Send response

    res.json({

        success: true,

        message: "Property update request received",

        propertyId: propertyId,

        updatedData: {

            name,
            location,
            type,
            price

        }

    });

});


// ======================================================
// PATCH PROPERTY EXAMPLE
// ======================================================

// PATCH is generally used when we want to update
// only part of a resource.
//
// URL:
// http://localhost:3000/api/properties/101

app.patch("/api/properties/:id", (req, res) => {


    // Get ID from route parameter
    const propertyId = req.params.id;


    // Get the data sent by the client
    const updateData = req.body;


    // Send response

    res.json({

        success: true,

        message: "Property partially updated",

        propertyId: propertyId,

        updateData: updateData

    });

});


// ======================================================
// SERVER
// ======================================================

// Start the Express server

app.listen(PORT, () => {

    console.log(
        `Server running at http://localhost:${PORT}`
    );

});
